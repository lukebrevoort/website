# Server-only. Add this value through Vercel Project Settings, never to client code.
OPENAI_API_KEY=
# Existing deployments using OpenAIKey are also accepted as a compatibility alias.

# Optional overrides; these are the application defaults.
CANVAS_VISION_PROVIDER=openai
CANVAS_OPENAI_MODEL=gpt-5.4

# Required in Preview/Production. A random 32+ byte value used only to HMAC
# daily session/IP identifiers; never expose this with NEXT_PUBLIC_.
CANVAS_USAGE_HMAC_SECRET=

# Distributed counters. Vercel KV and Upstash Redis REST names are both accepted.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile. Only the site key is public; the secret stays server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# Safe defaults; tune below the provider's active free-tier quota.
CANVAS_SESSION_DAILY_LIMIT=6
CANVAS_IP_DAILY_LIMIT=18
CANVAS_PROJECT_DAILY_LIMIT=180
CANVAS_COOLDOWN_MS=8000
CANVAS_IN_FLIGHT_MS=25000
CANVAS_EXECUTION_MS=18000
CANVAS_MAX_OUTPUT_TOKENS=1600

# Production defaults to requiring both controls. Set false only for local testing.
CANVAS_USAGE_STORAGE_REQUIRED=true
CANVAS_TURNSTILE_REQUIRED=true
